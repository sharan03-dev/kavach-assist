# Docker mode:  copy to .env and set your Docker Hub user (./publish.sh does this for you)
DOCKERHUB_USER=your-dockerhub-username
DOCKER_URL=https://hub.docker.com/r/your-dockerhub-username/nosql-lab18
AUTO_UPDATE_INTERVAL=300

# ---- Final assessment: Kavach Assist (chat) - setup_assist.sh fills ADMIN_PASSWORD and JWT_SECRET for you
ADMIN_EMAIL=admin@kavach.local
ADMIN_PASSWORD=
JWT_SECRET=
# GOOGLE_CLIENT_ID=            # "Continue with Google": an OAuth client id (README, section Google sign-in)
# LLM_BACKEND=auto             # auto | ollama | openai | anthropic | builtin
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # use Ollama installed on the Mac (faster: uses the GPU). Default: the ollama container
# ASSIST_OLLAMA_MODEL=auto     # auto = llama3.2:3b, or llama3.2:1b when the Docker VM has less than 7 GB
# OPENAI_API_KEY=              # optional hosted model instead of the local one
# CHAT_RATE_PER_MIN=20
# SCAN_INTERVAL=300            # seconds between two scans of the scanner bot

# Labs 16-18
# LAB13_K8S=off             # recommended on an 8 GB laptop when you start lab18 (skips Kubernetes of Lab 13.2)
# EMBEDDER=auto             # auto | voyage | fastembed | hashing
# VOYAGE_API_KEY=           # optional: Voyage AI embeddings (the course sample)
# ANTHROPIC_API_KEY=        # optional: real LLM answers in the Lab 17 RAG pipeline (otherwise the built-in generator)
# OLLAMA_URL=http://host.docker.internal:11434   # optional: a local model (OLLAMA_MODEL=llama3.2:1b)

# Lab 14
# LAB14_WEBHOOK_URL=https://hooks.slack.com/services/...   # optional: real Slack and/or Discord webhook(s), comma-separated
# LAB14_BACKUP_EVERY_MIN=60                                  # backup interval of the ops daemon (default: every hour)

# Lab 13
# LAB13_K8S=k3s          # k3s (default: Kubernetes runs in the k3s container) | off (skip Lab 13.2 on a small machine)
# ATLAS_URI=             # optional: the cluster_uri output of labs/lab13/terraform -> `lab13 cloud` tests the real Atlas cluster

# Local (macOS, no Docker) mode for Lab 7 only - Labs 8-10 need the replica set from Docker:
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=cti_platform
# LAB72_DB=cti_lab72
# IPSUM_MIN_HITS=2
# GCVE_DAYS=30
# GCVE_ENRICH_TOP=200
# GREYNOISE_API_KEY=
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
# OTX_API_KEY=
